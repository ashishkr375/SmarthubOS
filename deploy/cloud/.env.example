# Cloud API — Environment Variables
# Copy to .env and fill in all values before running.
# SECURITY: Never commit the real .env file. It is gitignored.

# ── PostgreSQL ──────────────────────────────────────────
# Full DSN — used by cloud-api binary.
DATABASE_URL=postgres://smarthub:changeme_strong@postgres:5432/smarthubos

# Used by docker-compose to initialise the postgres container.
POSTGRES_DB=smarthubos
POSTGRES_USER=smarthub
POSTGRES_PASSWORD=changeme_strong

# ── Cloud API ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be at least 32 bytes. Never commit this value.
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32

# HTTP listen port (default: 9090)
PORT=9090

# Set to true to apply DB migrations automatically on startup.
# Set to false in production and run migrations manually via the migrate CLI.
AUTO_MIGRATE=true

# Bootstrapped admin user credentials (used on first startup only).
ADMIN_EMAIL=admin@smarthubos.online
ADMIN_PASSWORD=replace_with_strong_admin_password

# ── Grafana HTTP API ────────────────────────────────────
# Leave GRAFANA_URL empty to skip Grafana org provisioning in local dev.
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=replace_with_grafana_admin_password

# ── Grafana Container ───────────────────────────────────
# (Read by docker-compose to configure the grafana service)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password
GRAFANA_DOMAIN=grafana.smarthubos.online
