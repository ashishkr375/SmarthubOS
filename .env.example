# PostgreSQL Configuration
# Database name for the SmartHub platform
POSTGRES_DB=smarthub

# PostgreSQL superuser username
POSTGRES_USER=smarthub_admin

# PostgreSQL superuser password
# SECURITY: Generate a secure random password (minimum 16 characters)
# Use a password generator: openssl rand -base64 24
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Grafana Configuration
# Grafana admin username
GRAFANA_ADMIN_USER=admin

# Grafana admin password
# SECURITY: Generate a secure random password (minimum 16 characters)
# Use a password generator: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password-here

# Grafana public domain (used for HTTPS and redirects)
GRAFANA_DOMAIN=grafana.example.com

# Caddy Configuration
# Email address for Let's Encrypt ACME certificate notifications
ACME_EMAIL=admin@example.com

# Security Notes:
# - Never commit the actual .env file to version control
# - Use cryptographically secure random generators for passwords
# - Minimum password length: 16 characters
# - Set file permissions to 600 (owner read/write only): chmod 600 .env
# - Rotate passwords regularly in production environments
